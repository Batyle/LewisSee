# Public EmailJS browser configuration. VITE_* values are visible in the deployed client.
VITE_EMAILJS_SERVICE_ID=your_student_service_id
VITE_EMAILJS_TEMPLATE_ID=your_student_template_id
VITE_EMAILJS_PUBLIC_KEY=your_student_public_key
VITE_ADMIN_INSTRUCTOR_EMAILJS_SERVICE_ID=your_admin_email_service_id
VITE_ADMIN_INSTRUCTOR_EMAILJS_TEMPLATE_ID=your_admin_email_template_id
VITE_ADMIN_INSTRUCTOR_EMAILJS_PUBLIC_KEY=your_admin_email_public_key
VITE_INSTRUCTOR_REQUEST_EMAILJS_SERVICE_ID=your_request_service_id
VITE_INSTRUCTOR_REQUEST_EMAILJS_TEMPLATE_ID=your_request_template_id
VITE_INSTRUCTOR_REQUEST_EMAILJS_PUBLIC_KEY=your_request_public_key
# Optional reply-to for admin → instructor notices.
VITE_ADMIN_NOTIFICATION_REPLY_TO=

# Live public API endpoints
VITE_LIVENESS_API_URL=https://liveliness-server.vercel.app/liveness
VITE_ATTENDANCE_API_URL=https://lewissee.onrender.com/attendance

# Server-only on Vercel and Render. Enter values in each provider's environment settings;
# never put DB_PASSWORD or signing secrets in a VITE_* variable or commit them.
DB_HOST=your_aiven_host
DB_PORT=your_aiven_port
DB_DATABASE=LewisSee
DB_USERNAME=avnadmin
DB_PASSWORD=set_in_host_environment
DB_SSL_MODE=REQUIRED
ADMIN_JWT_SECRET=generate_a_unique_random_secret_at_least_32_characters
CRON_SECRET=generate_another_unique_random_secret_at_least_32_characters
